# Backend template: complete privately, then install as /opt/openrole/.env.
# Settings reads the repository-root .env, not .env.production automatically.
# Leave secrets blank here; an unfilled template deliberately fails validation.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=
# Used by the documented production PostgreSQL Compose deployment.
POSTGRES_PASSWORD=
OBJECT_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
JOB_ABSENCE_CONFIRMATION_RUNS=2
# Deliberate single-host alternative: change OBJECT_STORAGE_BACKEND=filesystem
# and uncomment a provisioned absolute persistent directory outside releases.
# LOCAL_STORAGE_PATH=/var/lib/openrole/raw
