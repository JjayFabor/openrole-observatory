# Backend template: enter values in Render's Environment settings.
# Settings accepts service variables; .env.production is not loaded automatically.
# Leave secrets blank here; an unfilled template deliberately fails validation.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=
# Separate service-to-service credential, at least 32 random characters.
ADMIN_API_TOKEN=
OBJECT_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
JOB_ABSENCE_CONFIRMATION_RUNS=2
# Render API and cron share private R2 storage; cron cannot use persistent disks.
