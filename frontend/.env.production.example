# Frontend SERVER settings. Never put backend credentials in NEXT_PUBLIC_*.
NODE_ENV=production
# Enter the actual HTTPS Render API origin. Localhost is not Render from Vercel.
OPENROLE_API_BASE_URL=https://replace-with-your-api.onrender.com
# Copy Render's ADMIN_API_TOKEN privately; never expose it with NEXT_PUBLIC_*.
OPENROLE_ADMIN_API_TOKEN=
# Single operator HTTP Basic credentials; password needs at least 32 characters.
OPENROLE_DASHBOARD_USERNAME=
OPENROLE_DASHBOARD_PASSWORD=
# Set the actual HTTPS public origin for BOTH build and startup.
# Blank deliberately disables indexing, canonical URLs and sitemap advertisement.
OPENROLE_SITE_URL=
# Optional: an existing production source UUID; blank monitors no single source.
OPENROLE_DEFAULT_SOURCE_ID=
