OPENROLE_API_BASE_URL=http://localhost:8000
# Canonical origin only (no path/query). Set for both build and server startup.
# Leave blank locally: no indexing, canonical URLs, or sitemap advertisement.
# Production requires an HTTPS origin and rejects localhost/loopback addresses.
OPENROLE_SITE_URL=
# Optional development limitation: monitor one existing source UUID.
OPENROLE_DEFAULT_SOURCE_ID=
