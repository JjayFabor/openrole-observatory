APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://openrole:openrole@localhost:5434/openrole
OBJECT_STORAGE_BACKEND=filesystem
LOCAL_STORAGE_PATH=.local-data
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openrole-development
R2_REGION=auto
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
# Phase 2 supports exactly two runs; other values fail settings validation.
JOB_ABSENCE_CONFIRMATION_RUNS=2
